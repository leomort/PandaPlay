<?xml version="1.0" encoding="utf-8"?>
<!-- Card de jogo: borda amarela quando está com foco (controle/TV) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26303A"/>
            <stroke android:width="3dp" android:color="#F2B233"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E7D5B"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2227"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
