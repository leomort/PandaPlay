<?xml version="1.0" encoding="utf-8"?>
<!-- Botões de filtro: verde quando selecionado, borda amarela quando focado pelo controle/TV -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E7D5B"/>
            <stroke android:width="3dp" android:color="#F2B233"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2E7D5B"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E2227"/>
            <stroke android:width="1dp" android:color="#3A4048"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
</selector>
